# avo provider configuration
#
# Copy this file to `.env` (which is git-ignored) and fill in only the
# variables that apply to your deployment. Never commit a `.env` file
# containing real API keys.

# ---------------------------------------------------------------------------
# Provider selection (required)
# ---------------------------------------------------------------------------

# ollama | minimax | anthropic | openai
AVO_PROVIDER=

# Default model name for the active provider
AVO_MODEL=

# ---------------------------------------------------------------------------
# Ollama (local, typically no API key)
# ---------------------------------------------------------------------------

# AVO_OLLAMA_BASE_URL=http://localhost:11434
# AVO_OLLAMA_MODEL=
# AVO_OLLAMA_API_KEY=

# ---------------------------------------------------------------------------
# MiniMax
# ---------------------------------------------------------------------------

# AVO_MINIMAX_API_KEY=
# AVO_MINIMAX_BASE_URL=https://api.minimax.io
# AVO_MINIMAX_MODEL=
# AVO_MINIMAX_API_STYLE=anthropic

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------

# AVO_ANTHROPIC_API_KEY=
# AVO_ANTHROPIC_MODEL=
# AVO_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------------------
# OpenAI (and OpenAI-compatible self-hosted endpoints)
# ---------------------------------------------------------------------------

# AVO_OPENAI_API_KEY=
# AVO_OPENAI_MODEL=
# AVO_OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Runtime overrides (optional)
# ---------------------------------------------------------------------------

# AVO_DATABASE_PATH=
# AVO_MAX_TOTAL_TOKENS=
# AVO_MAX_RUNTIME_SECONDS=
# AVO_REPEATED_ACTION_LIMIT=

# AVO_PERMISSION_MODE=default
# AVO_TOOLS_REQUIRE_APPROVAL=
# AVO_USAGE_RATES_INPUT_PER_1K=
# AVO_USAGE_RATES_OUTPUT_PER_1K=

# AVO_NOTIFY_WEBHOOK=
# AVO_NOTIFY_DESKTOP=0
